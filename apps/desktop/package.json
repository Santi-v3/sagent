{
  "name": "@sagent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sagent desktop app",
  "author": "Santi",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "pnpm build:web && pnpm bundle:static && electron-builder",
    "build:mac": "pnpm build:web && pnpm bundle:static && electron-builder --mac",
    "build:win": "pnpm build:web && pnpm bundle:static && electron-builder --win",
    "build:linux": "pnpm build:web && pnpm bundle:static && electron-builder --linux",
    "build:web": "pnpm --filter @sagent/web build",
    "bundle:static": "node -e \"const fs=require('fs'); const p=require('path'); const out='web-out'; if(fs.existsSync(out)) fs.rmSync(out,{recursive:true}); fs.cpSync(p.join('..','web','out'),out,{recursive:true});\""
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.sagent.desktop",
    "productName": "Sagent",
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "files": [
      "main.js",
      "web-out/**/*"
    ],
    "extraResources": [
      {
        "from": "../agent-api",
        "to": "agent-api",
        "filter": ["src/**/*", "pyproject.toml"]
      },
      {
        "from": "../../packages/tools",
        "to": "packages/tools",
        "filter": ["src/**/*", "pyproject.toml"]
      },
      {
        "from": "../../packages/agent-core",
        "to": "packages/agent-core",
        "filter": ["src/**/*", "pyproject.toml"]
      },
      {
        "from": "../../packages/memory",
        "to": "packages/memory",
        "filter": ["src/**/*", "pyproject.toml"]
      },
      {
        "from": "../../packages/shared",
        "to": "packages/shared",
        "filter": ["src/**/*", "pyproject.toml"]
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
